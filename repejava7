import java.util.Scanner;

public class R2 {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        System.out.print("Ingrese un numero de tres digitos: ");
        int numero = entrada.nextInt();

        int original = numero;
        int suma = 0;

        while (numero > 0) {
            int digito = numero % 10;
            suma = suma + (int) Math.pow(digito, 3);
            numero = numero / 10;
        }

        if (suma == original && original >= 100 && original <= 999) {
            System.out.println("Es un numero de Armstrong");
        } else {
            System.out.println("No es un numero de Armstrong");
        }

        entrada.close();
    }
}
